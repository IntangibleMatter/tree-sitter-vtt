{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "vtt",
      "camelcase": "WebVTT",
      "title": "VTT",
      "scope": "source.vtt",
      "file-types": [
        "vtt"
      ],
      "injection-regex": "^vtt$",
      "class-name": "TreeSitterVtt"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter parser for vtt files",
    "authors": [
      {
        "name": "IntangibleMatter",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-vtt",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}